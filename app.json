{
  "expo": {
    "name": "BLUEMIND",
    "slug": "bluemind",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/logo.png",
    "extra": {
      "API_BASE_URL": "https://ocean-cleanup-cardano-v2.vercel.app",
      "eas": {
        "projectId": "45da1507-aa9d-4056-b3e0-e68660379782"
      }
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bluemind.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.bluemind.mobile",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png"
      }
    },
    "owner": "keyur-cloudpeaks-team",
    "plugins": [
      "expo-audio"
    ]
  }
}
